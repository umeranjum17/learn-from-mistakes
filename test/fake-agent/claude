#!/usr/bin/env node
// A fake Claude Code for the run journeys: `--version`, and one answer to the prompt on stdin, as `claude -p
// --output-format json` gives it. FAKE_ANALYSE picks the answer: empty (the default) names nothing; label labels each
// defect record in the bundle as FAKE_CAUSE (default other) and names two findings, the second with one ref to no bundle
// item; prose answers in plain text; blank answers nothing; hang never answers. The propose step (its marker line) gets
// a reason for each follow-up it lists and, with FAKE_PROPOSE=eight, eight fixes for FAKE_CAUSE citing the bundle's
// records (or its first item when it has none): the sixth with metric defects, the seventh for a cause that did not repeat, the eighth with no tripwire.
// FAKE_PROPOSE=long gives two fixes, the second with a change of four sentences, on every answer. FAKE_PROPOSE=plain gives
// three fixes: one in plain active words, one with a non-plain word (utilize) and one in the passive voice, on every
// answer. FAKE_PROPOSE=twin gives one
// fix for FAKE_CAUSE citing only the second record; with FAKE_FINDINGS=twins, label names two findings under FAKE_CAUSE, one per record.
// FAKE_PROPOSE=quote gives two fixes: one whose change copies a record sentence word for word (the quote rule
// refuses it) and one that paraphrases it (kept), on every answer.
// FAKE_DUP=1 makes every label after the first a duplicate of the first record; FAKE_OCC=n gives the first label n occurrences.
// The verify step (its marker line) gets a verdict for each claim it lists: refuted for a claim id in FAKE_REFUTE (a comma
// list), weakened for one in FAKE_WEAKEN, none for one in FAKE_UNJUDGED (left out every time), else confirmed.
// Linked as `codex` it is a fake Codex, the judge: it writes the answer to its -o file, as `codex exec` does.
// FAKE_LOG, when set, is a dir that gets each call's argv, cwd and stdin, in <name>.jsonl. FAKE_CANARY, when set, is
// added as a last word to each sentence that ends a text field of the answer.
import { appendFileSync, readFileSync, writeFileSync } from 'node:fs';
import { basename, join } from 'node:path';

const args = process.argv.slice(2), name = basename(process.argv[1]);
if (args[0] === '--version') { console.log(`2.0.0 (fake ${name})`); process.exit(0); }
const stdin = readFileSync(0, 'utf8');
if (process.env.FAKE_LOG) appendFileSync(join(process.env.FAKE_LOG, `${name}.jsonl`), `${JSON.stringify({ args, cwd: process.cwd(), stdin })}\n`);
const mode = process.env.FAKE_ANALYSE || 'empty';
const reply = (answer, extra = {}) => { const result = process.env.FAKE_CANARY ? answer.replace(/\.(?=")/g, ` ${process.env.FAKE_CANARY}.`) : answer;
  return name === 'codex' ? args.includes('-o') && writeFileSync(args[args.indexOf('-o') + 1], result)
    : console.log(JSON.stringify({ type: 'result', is_error: false, result, session_id: 'fake-session', usage: { input_tokens: 10, cache_read_input_tokens: 2, output_tokens: 5 }, ...extra })); };
if (mode === 'hang') setInterval(() => {}, 1000);
else if (/^lfm-run:\d+:verify\n/.test(stdin)) {
  const claims = [...stdin.slice(stdin.indexOf('Claims to judge:'), stdin.indexOf('Reply with one JSON object')).matchAll(/^- (\w+):/gm)].map((m) => m[1]);
  const has = (v, item) => (process.env[v] ?? '').split(',').includes(item);
  reply(JSON.stringify({ verdicts: claims.filter((item) => !has('FAKE_UNJUDGED', item)).map((item) => (has('FAKE_REFUTE', item) ? { item, verdict: 'refuted', reason: 'The cited items show a different failure for Umer.' }
    : has('FAKE_WEAKEN', item) ? { item, verdict: 'weakened', reason: 'The cited items show this only once for Umer.' } : { item, verdict: 'confirmed', reason: 'The cited items show this for Umer.' })) }));
}
// The apply step (its marker line) appends its rule line to each named file. FAKE_APPLY=cut returns a reply cut off
// mid-line (each file truncated to half), and FAKE_APPLY=length returns whole file text with the result envelope a
// length stop gives (stop_reason: max_tokens): apply must refuse both.
else if (/^lfm-run:\d+:apply-\d+\n/.test(stdin)) {
  const blocks = [...stdin.matchAll(/^--- (.+)\n([\s\S]*?)\n--- end of \1$/gm)];
  const cut = process.env.FAKE_APPLY === 'cut';
  const files = blocks.map(([, path, text]) => ({ path, content: cut ? text.slice(0, Math.max(1, Math.floor(text.length / 2))) : `${text}- Give each worker its own cache directory, Umer.\n` }));
  reply(JSON.stringify({ files }), process.env.FAKE_APPLY === 'length' ? { stop_reason: 'max_tokens' } : {}); }
else if (/^lfm-run:\d+:propose\n/.test(stdin)) {
  const bundle = stdin.slice(stdin.indexOf('# Retro bundle'));
  const records = [...bundle.slice(bundle.indexOf('## Unlabelled defect records')).matchAll(/^- \[([^\]]+)\]/gm)].map((m) => m[1]);
  const refs = records.length ? records : [bundle.match(/^(?:### |- )\[([^\]]+)\]/m)?.[1]];
  const followups = stdin.slice(stdin.indexOf('Follow-ups to explain:'), stdin.indexOf('Reply with one JSON object'));
  const fix = (target, more) => ({ cause: process.env.FAKE_CAUSE || 'other', target: process.env.FAKE_TARGET || target, kind: process.env.FAKE_KIND || 'code', owner: 'maintainer', change: 'Give each worker its own cache directory.', metric: null, tripwire: '<= 0', refs, ...more });
  const proposals = process.env.FAKE_PROPOSE === 'long' ? [fix('launch script 1'), fix('launch script 2', { change: 'Give each worker its own cache directory. Keep the lock out of it. Run the launch script alone. Check the result.' })]
    : process.env.FAKE_PROPOSE === 'plain' ? [fix('launch script 1'), fix('launch script 2', { change: 'We will utilize the cache.' }), fix('launch script 3', { change: 'The lock was held by us.' })]
    : process.env.FAKE_PROPOSE === 'quote' ? [fix('launch script 1', { change: 'Give each worker its own cache directory. The nightly backlog queue filled and blocked the morning release workers.' }),
      fix('launch script 2', { change: 'Give each worker its own cache directory for every lane.' })]
    : process.env.FAKE_PROPOSE === 'twin' ? [fix('launch script 1', { refs: records.slice(1, 2) })]
    : process.env.FAKE_PROPOSE !== 'eight' ? [] :[...[1, 2, 3, 4, 5].map((k) => fix(`launch script ${k}`)),
    fix('launch script 6', { metric: 'defects' }), fix('test setup', { cause: 'umer-fixtures-unset' }), fix('cache config', { tripwire: null })];
  const answer = { proposals,
    reasons: [...followups.matchAll(/^- (chg-\d+):/gm)].map((m) => ({ change: m[1], reason: 'Too few sessions ran after the change for Umer.' })) };
  reply(JSON.stringify(answer));
} else {
  const bundle = stdin.slice(stdin.indexOf('# Retro bundle'));
  const records = [...bundle.slice(bundle.indexOf('## Unlabelled defect records')).matchAll(/^- \[([^\]]+)\]/gm)].map((m) => m[1]);
  const first = bundle.match(/^(?:### |- )\[([^\]]+)\]/m)?.[1];
  const answer = mode === 'blank' ? '' : mode === 'prose' ? 'I read the bundle. Nothing looks wrong.' : JSON.stringify(mode === 'empty' ? { findings: [], labels: [] }
    : mode === 'outside' ? { findings: [], labels: [{ id: 'nowhere-9', event: true, cause: 'other', why: 'The run failed for Umer.' }] } : {
      findings: process.env.FAKE_FINDINGS === 'twins' ? [{ cause: process.env.FAKE_CAUSE, summary: 'First twin failed alone.', refs: [records[0]] },
        { cause: process.env.FAKE_CAUSE, summary: 'Second twin failed alone.', refs: [records[1]] }]
        : [{ cause: 'umer-fixtures-unset', summary: 'The tests fail when UMER_FIXTURES is unset. No doc names it.', refs: [first] },
          { cause: 'made-up', summary: 'This finding cites an item the bundle does not have.', refs: [first, 'c99'] }],
      labels: records.map((id, i) => ({ id, event: true, cause: process.env.FAKE_CAUSE || 'other', why: 'The run failed for Umer.', duplicate_of: i > 0 && process.env.FAKE_DUP ? records[0] : null, occurrences: i === 0 && process.env.FAKE_OCC ? Number(process.env.FAKE_OCC) : null, confidence: null })),
    });
  reply(answer);
}
